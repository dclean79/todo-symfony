{% extends 'base.html.twig' %}
{% block title %}Nowe zadanie{% endblock %}
{% block body %}
<h1 class="text-xl font-semibold mb-4">Nowe zadanie</h1>
<div class="bg-white shadow rounded p-6">
    {{ form_start(form) }}
        <div class="mb-4">
            {{ form_label(form.title) }}
            {{ form_widget(form.title, {attr: {class: 'mt-1 block w-full border rounded p-2'}}) }}
            {{ form_errors(form.title) }}
        </div>

        <div class="mb-4">
            {{ form_label(form.description) }}
            {{ form_widget(form.description, {attr: {class: 'mt-1 block w-full border rounded p-2'}}) }}
            {{ form_errors(form.description) }}
        </div>

        <div class="mb-4">
            {{ form_label(form.dueAt) }}
            {{ form_widget(form.dueAt, {attr: {class: 'mt-1 block w-full border rounded p-2'}}) }}
            {{ form_errors(form.dueAt) }}
        </div>

        <div class="mb-4 flex items-center gap-2">
            {{ form_widget(form.isDone) }}
            {{ form_label(form.isDone) }}
        </div>

        <button class="px-4 py-2 bg-blue-600 text-white rounded">Zapisz</button>
    {{ form_end(form) }}
</div>
{% endblock %}
