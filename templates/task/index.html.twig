{% extends 'base.html.twig' %}
{% block title %}Lista zadań{% endblock %}

{% block body %}
<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {% for task in tasks %}
        <div class="bg-white shadow-md rounded-lg p-6 hover:shadow-lg transition">
            <h2 class="text-lg font-semibold {{ task.isDone ? 'line-through text-gray-400' : 'text-gray-800' }}">
                {{ task.title }}
            </h2>
            {% if task.description %}
                <p class="text-sm text-gray-600 mt-2">{{ task.description }}</p>
            {% endif %}
            {% if task.dueAt %}
                <p class="text-xs text-gray-500 mt-2">📅 Termin: {{ task.dueAt|date('Y-m-d H:i') }}</p>
            {% endif %}

            <div class="flex gap-2 mt-4">
                <form action="{{ path('task_toggle', {id: task.id}) }}" method="post">
                    <button class="btn {{ task.isDone ? 'btn-warning' : 'btn-success' }}">
                        {{ task.isDone ? 'Przywróć' : 'Zakończ' }}
                    </button>
                </form>
                <a href="{{ path('task_edit', {id: task.id}) }}" class="btn btn-primary">Edytuj</a>
                <form action="{{ path('task_delete', {id: task.id}) }}" method="post" onsubmit="return confirm('Usunąć zadanie?')">
                    <button class="btn btn-danger">Usuń</button>
                </form>
            </div>
        </div>
    {% else %}
        <div class="col-span-3 text-center text-gray-500 py-12">
            <p class="text-lg">Brak zadań</p>
            <p class="text-sm mt-2">Kliknij „Dodaj”, aby utworzyć pierwsze.</p>
        </div>
    {% endfor %}
</div>
{% endblock %}
