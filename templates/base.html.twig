<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}ToDo{% endblock %}</title>
    <link rel="icon" href="/favicon.ico">
    {{ encore_entry_link_tags('app') }}
</head>
<body class="bg-light text-dark min-vh-100 d-flex flex-column">

<header class="navbar navbar-expand-lg navbar-light bg-light border-bottom shadow-sm">
    <div class="container">
        <a class="navbar-brand fw-semibold" href="#">📝 ToDo</a>
        <div class="d-flex ms-auto gap-3">
            <!-- Lista -->
            <a href="{{ path('task_index') }}" 
               class="btn btn-outline-secondary d-flex align-items-center">
                <i class="bi bi-list-check me-2"></i>
                <span>Lista</span>
            </a>
            <!-- Dodaj -->
            <a href="{{ path('task_new') }}" 
               class="btn btn-outline-secondary d-flex align-items-center">
                <i class="bi bi-plus-square-fill me-2"></i>
                <span>Dodaj</span>
            </a>
        </div>
    </div>
</header>

<main class="flex-grow-1 container py-4">
    {% block body %}{% endblock %}
</main>

<footer class="bg-light text-muted text-center py-4 border-top">
    <p>&copy; {{ "now"|date("Y") }} ToDo App – Symfony + Bootstrap</p>
</footer>

{{ encore_entry_script_tags('app') }}
</body>
</html>
