<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}ToDo{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('build/app.css') }}">
</head>
<body class="bg-gray-50 text-gray-900 min-h-screen flex flex-col">

    <!-- Navbar -->
    <header class="bg-blue-700 text-white shadow">
        <div class="container mx-auto px-6 py-4 flex justify-between items-center">
            <h1 class="text-2xl font-bold">📝 ToDo</h1>
            <nav class="space-x-6">
                <a href="{{ path('task_index') }}" class="hover:underline">Lista</a>
                <a href="{{ path('task_new') }}" class="hover:underline">Dodaj</a>
            </nav>
        </div>
    </header>

    <!-- Main -->
    <main class="flex-1 container mx-auto px-6 py-8 flex gap-8">
        <!-- Content -->
        <section class="flex-1">
            {% block body %}{% endblock %}
        </section>
    </main>

    <!-- Footer -->
    <footer class="bg-gray-200 text-gray-600 text-center py-4">
        <p>&copy; {{ "now"|date("Y") }} ToDo App – Symfony + Tailwind</p>
    </footer>

</body>
</html>
